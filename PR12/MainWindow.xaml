<Window x:Class="PR12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR12"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Frame x:Name="MainFrame" Grid.Row="0" 
               Source="Pages/FirstPage.xaml" 
               NavigationUIVisibility="Hidden" 
               Navigating="OnNavigating" 
               NavigationStopped="MainFrame_NavigationStopped"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" >
                <Button Content="Вернуться назад" Click="Return_click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,0" Height="40" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="18" Text="Стоимость:" Grid.Row="1" Margin="25" x:Name="Itog"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="2" Height="30" Minimum="1" Maximum="6" Value="1" ></ProgressBar>
    </Grid>
</Window>
