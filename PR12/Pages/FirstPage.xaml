<Page x:Class="PR12.Pages.FirstPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="FirstPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="400"/>
            <ColumnDefinition MinWidth="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="200" Width="140">
            <Label Content="Модель" Margin="0, 40, 0, 0"></Label>
            <RadioButton Checked="ToggleButton_OnChecked" Content="Седан (400 000)" GroupName="Model" Margin="0, 20, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked" Content="Кроссовер (1 000 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked" Content="Купе (600 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked" Content="Джип (1 500 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked" Content="Танк (25 000 000)" GroupName="Model" Margin="0, 10, 0, 0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Label Content="Тип двигателя" Margin="0, 40, 0, 0"></Label>
            <RadioButton Checked="ToggleButton_OnChecked_2" Content="Бензиновый (x 1)" GroupName="Engine" Margin="0, 20, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked_2" Content="Электрический (x 2)" GroupName="Engine" Margin="0, 20, 0, 0"/>
            <RadioButton Checked="ToggleButton_OnChecked_2" Content="Турбореактивный (x 7)" GroupName="Engine" Margin="0, 20, 0, 0"/>
        </StackPanel>

        <Button Grid.ColumnSpan="2" Grid.Row="1" Content="Далее" Click="B_click" Height="40" Width="200"/>
    </Grid>
</Page>
