<Page x:Class="PR14.Pages.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookingPage">

    <Grid  Background="#6b6b6b">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Ваш заказ" FontSize="28" FontWeight="Bold" Margin="10,0,0,20" Foreground="White"/>
            <Border BorderBrush="#c20081" BorderThickness="1" CornerRadius="5" Padding="10" Margin="10,5,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtMovieTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="TxtDateTime" FontSize="16" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="TxtHall" FontSize="16" TextWrapping="Wrap" Foreground="White"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Способ оплаты" FontSize="16" FontWeight="Bold" Margin="10,20,0,5" Foreground="White"/>
            <ComboBox SelectedIndex="0" Padding="5" Margin="10,5,0,0">
                <ComboBoxItem Content="Карта"/>
                <ComboBoxItem Content="СБП"/>
            </ComboBox>
            <TextBox Margin="10,10,0,0" Padding="5" Text="**** **** **** ****" IsReadOnly="True" Background="#F0F0F0"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Билеты" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" TextAlignment="Center"/>

            <ListView x:Name="LViewSeats" Height="250" BorderBrush="Gray" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Ряд" DisplayMemberBinding="{Binding RowNumber}" Width="50"/>
                        <GridViewColumn Header="Место" DisplayMemberBinding="{Binding SeatNumber}" Width="50"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20">
                <TextBlock Text="К оплате: " FontSize="20" Foreground="White"/>
                <TextBlock x:Name="TxtTotalPrice" Text="0 руб" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>

            <Button Content="ОПЛАТИТЬ И ЗАБРОНИРОВАТЬ" Click="BtnConfirm_Click" 
                    Background="#c20081" Foreground="White" FontWeight="Bold" FontSize="16" 
                    Height="40" Width="300" Margin="0,10"/>

            <Button Content="Назад к выбору мест" Click="BtnBack_Click" Background="#c20081" BorderThickness="0" Foreground="White" 
                    FontSize="16" FontWeight="Bold" Height="30" Width="300"/>
        </StackPanel>
    </Grid>
</Page>
