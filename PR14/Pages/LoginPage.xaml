<Page x:Class="PR14.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Border Background="#6b6b6b" CornerRadius="10" Padding="20" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="300"
                BorderBrush="#c20081" BorderThickness="3">

            <StackPanel>
                <TextBlock Text="Aвторизация"  FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"  Foreground="White" Margin="0,0,0,20"/>
                
                <Label Content="Логин:" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <Label Content="Пароль" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <PasswordBox x:Name="PBoxPassword" Height="30" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                <Button Content="Войти" Height="30" Background="#c20081" Foreground="White" 
                        FontWeight="Bold" Click="BtnLogin_Click" FontSize="14"/>
                
                <Button Content="Нет аккаунта? Зарегистрироваться" Margin="0,10,0,10" 
                        Background="Transparent" BorderThickness="0" Foreground="Blue" 
                        Cursor="Hand" Click="BtnReg_Click"/>
                
                <Button Content="Назад на главную" Margin="0,5,0,0" 
                        Background="Transparent" BorderThickness="0" Foreground="White" 
                         Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
