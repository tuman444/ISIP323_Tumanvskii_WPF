<Page x:Class="PR14.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="#6b6b6b">
            <Label Content="Поиск" Background="#c20081" VerticalAlignment="Center" Foreground="White" 
           FontSize="14" FontWeight="Bold" FontFamily="Arial Black" Margin="5,0,0,0"/>
            <TextBox x:Name="TxtSearch" Width="200" Margin="5" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>

            <Label Content="Сортировка:" VerticalAlignment="Center" Margin="10,0,0,0" Background="#c20081" Foreground="White" 
           FontSize="14" FontWeight="Bold" FontFamily="Arial Black"/>
            <ComboBox x:Name="CmbSort" Width="150" Margin="5" VerticalAlignment="Center" SelectionChanged="CmbSort_SelectionChanged"
                      >
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По названию (А-Я)"/>
                <ComboBoxItem Content="По рейтингу (высокий)"/>
            </ComboBox>

            <Button Content="Регистрация / Вход" Margin="15,0,0,0" Padding="10,5" Background="#c20081" Foreground="White" 
           FontSize="14" FontWeight="Bold" FontFamily="Arial Black" Click="BtnLogin_Click"/>
        </StackPanel>

        <ListView x:Name="LViewMovies" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          BorderThickness="0" Background="#6b6b6b" MouseDoubleClick="LViewMovies_MouseDoubleClick">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="#c20081" CornerRadius="5" Margin="10" Width="220" Height="430" Background="WhiteSmoke">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Width="200" Height="300" Stretch="UniformToFill" Margin="5"/>

                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Background="#c20081" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="5"  Foreground="WhiteSmoke"/>

                            <TextBlock Text="{Binding GenreString}" FontSize="12" Foreground="Black" FontWeight="Bold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Margin="5,0,5,5" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <TextBlock Text="Рейтинг" Foreground="Black" Margin="5,0,0,0" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Rating}" FontWeight="Bold" Foreground="Black" Margin="5,0,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" BorderBrush="#c20081" BorderThickness="1" CornerRadius="5" Padding="0.5" Background="#c20081" Margin="0,0,5,0">
                                    <TextBlock Text="{Binding AgeRating}" Foreground="WhiteSmoke" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="В кино с: " FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
