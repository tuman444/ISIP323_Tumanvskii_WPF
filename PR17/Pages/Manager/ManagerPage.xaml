<Page x:Class="PR17.Pages.Manager.ManagerPage"
      IsVisibleChanged="Page_IsVisibleChanged"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Странница менеджера">

    <Grid Background="#F8F9FA" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="Список товаров" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                <Button Content="+ Добавить товар" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="160" Height="35" 
                        Background="#E67E22" Foreground="White" BorderThickness="0" FontWeight="Bold" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="DGridProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" 
                  HeadersVisibility="Column" RowHeight="50">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2C3E50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8F9FA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>

                <DataGridTemplateColumn Header="Фото" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Height="40" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ProductTypes.Name}" Width="120"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturers.Name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding DiscountPercentage, StringFormat={}{0}%}" Width="80"/>

                <DataGridTemplateColumn Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Изменить" Width="85" Height="25" Margin="0,0,5,0" 
                                        Background="#3498DB" Foreground="White" BorderThickness="0"
                                        Click="BtnEdit_Click" Tag="{Binding}"/>
                                <Button Content="Удалить" Width="65" Height="25" 
                                        Background="#E74C3C" Foreground="White" BorderThickness="0"
                                        Click="BtnDelete_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
