<Page x:Class="PR17.Pages.Manager.ManagerPage"
      IsVisibleChanged="Page_IsVisibleChanged"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Странница менеджера">

    <Grid Background="#F8F9FA" Margin="10">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Товары" FontSize="14">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="Управление товарами" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="+ Добавить товар" HorizontalAlignment="Right" Width="150" Height="30" 
                                    Background="#E67E22" Foreground="White" BorderThickness="0" Click="Button_Click"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DGridProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Заморозка" Binding="{Binding IsFrozen}" Width="80"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Изменить" Width="80" Margin="2" Background="#3498DB" Foreground="White" Click="BtnEdit_Click" Tag="{Binding}"/>
                                            <Button Content="Удалить" Width="80" Margin="2" Background="#E74C3C" Foreground="White" Click="BtnDelete_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Записи" FontSize="14" >
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2C3E50" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Поиск (ФИО/Тел):" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TbxSearchClient" Width="250" Height="25" TextChanged="TbxSearchClient_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DGridAppointments" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding AppointmentDateTime, StringFormat={}{0:dd.MM HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Users.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Перенести" Margin="2" Click="BtnReschedule_Click" Tag="{Binding}"/>
                                            <Button Content="Отмена" Margin="2" Background="#E74C3C" Foreground="White" Click="BtnCancelApp_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы" FontSize="14" >
                <DataGrid x:Name="DGridOrders" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Users.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Выдать" Background="#E67E22" Foreground="White" Click="BtnDeliverOrder_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
