<Page x:Class="PR17.Pages.Manager.ManagerPage"
      IsVisibleChanged="Page_IsVisibleChanged"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Странница менеджера">

    <Grid Background="#F8F9FA" Margin="10">
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="Товары" FontSize="14">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="Список товаров" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="+ Добавить товар" DockPanel.Dock="Right" Width="160" Height="35" 
                                    Background="#E67E22" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Button_Click" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DGridProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Заморозка" Binding="{Binding IsFrozen}" Width="80"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Изменить" Width="85" Height="25" Margin="0,0,5,0" 
                                                    Background="#3498DB" Foreground="White" BorderThickness="0"
                                                    Click="BtnEdit_Click" Tag="{Binding}"/>
                                            <Button Content="Удалить" Width="65" Height="25" 
                                                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                    Click="BtnDelete_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Записи" FontSize="14" >
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2C3E50" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Поиск клиента:" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TbxSearchClient" Width="250" Height="25" TextChanged="TbxSearchClient_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DGridAppointments" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding AppointmentDateTime, StringFormat={}{0:dd.MM HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Users.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding Services.Name}" Width="*"/>
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Редактировать" Width="100" Height="25" Margin="5,0"
                                                Background="#E67E22" Foreground="White" BorderThickness="0"
                                                Click="BtnReschedule_Click" Tag="{Binding}"/>
                                            <Button Content="Отменить" Width="80" Height="25" 
                                                Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                Click="BtnCancel_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы" FontSize="14" >
                <DataGrid x:Name="DGridOrders" Margin="10" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Users.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Выдать" Background="#E74C3C" Foreground="White" Click="BtnDeliverOrder_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2C3E50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </TabItem>

            <TabItem Header="Типы услуг" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="Типы услуг" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="+ Добавить тип" DockPanel.Dock="Right" Width="160" Height="35" 
                                Background="#E67E22" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAddServiceType_Click" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="DGridServiceTypes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CellEditEnding="DGridServiceTypes_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название типа" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить" Click="BtnDeleteType_Click" Background="#E74C3C" Foreground="White" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
