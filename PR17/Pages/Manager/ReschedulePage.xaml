<Page x:Class="PR17.Pages.Manager.ReschedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReschedulePage">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="#34495E" CornerRadius="15" Padding="30" Width="450">
            <StackPanel>
                <TextBlock Text="Редактирование записи" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="White"/>

                <TextBlock Text="Клиент:" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="TblClientName" Text="Имя клиента" Margin="0,5,0,15" FontSize="16" Foreground="White"/>

                <TextBlock Text="Услуга:" FontWeight="SemiBold" Foreground="White"/>
                <ComboBox x:Name="CmbService" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,15" Height="30"/>

                <TextBlock Text="Мастер:" FontWeight="SemiBold" Foreground="White"/>
                <ComboBox x:Name="CmbMaster" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,5,0,15" Height="30"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Новая дата:" FontWeight="SemiBold" Foreground="White"/>
                        <DatePicker x:Name="DpNewDate" Margin="0,5,0,15"/>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Время:" FontWeight="SemiBold" Foreground="White"/>
                        <ComboBox x:Name="CmbTime" Margin="0,5,0,15">
                            <ComboBoxItem Content="09:00"/>
                            <ComboBoxItem Content="10:00"/>
                            <ComboBoxItem Content="11:00"/>
                            <ComboBoxItem Content="12:00"/>
                            <ComboBoxItem Content="14:00"/>
                            <ComboBoxItem Content="15:00"/>
                            <ComboBoxItem Content="16:00"/>
                            <ComboBoxItem Content="17:00"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="Сохранить" Click="BtnSave_Click" Height="35" Margin="5" Background="#E67E22" Foreground="White" BorderThickness="0"/>
                    <Button Content="Отмена" Click="BtnCancel_Click" Height="35" Margin="5" Background="Gray" Foreground="White" BorderThickness="0"/>
                </UniformGrid>
            </StackPanel>
        </Border> 
    </Grid>
</Page>
