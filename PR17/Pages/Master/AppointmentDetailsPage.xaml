<Page x:Class="PR17.Pages.Master.AppointmentDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Salon"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Детали записи">

    <Grid Background="#F8F9FA">
        <Border Background="#2C3E50" CornerRadius="15" Padding="30" Margin="50" VerticalAlignment="Top" 
                HorizontalAlignment="Center" Width="500" BorderBrush="#DEE2E6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Детали записи" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="White"/>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Дата и Время" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtDateTime" Grid.Row="0" Grid.Column="1" FontSize="16" Foreground="White"/>

                    <TextBlock Text="Клиент:" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtClient" Grid.Row="1" Grid.Column="1" FontSize="16" Foreground="White"/>

                    <TextBlock Text="Услуга:" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtService" Grid.Row="2" Grid.Column="1" FontSize="16" Foreground="White"/>

                    <TextBlock Text="Статус:" FontWeight="SemiBold" Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                    <Border Grid.Row="3" Grid.Column="1" Background="#E67E22" CornerRadius="5" Padding="5,2" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtStatus" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="Комментарий:" FontWeight="SemiBold" Grid.Row="4" Grid.Column="0" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtComment" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontStyle="Italic" Foreground="White"/>
                </Grid>
                <Button Content="Назад к расписанию" Margin="0,30,0,0" Height="40" 
                        Background="#E67E22" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Click="BtnBack_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
