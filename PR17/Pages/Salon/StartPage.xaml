<Page x:Class="PR17.Pages.Salon.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Salon"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Услуги салона">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F8F9FA" Padding="15" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Поиск:" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="TbxSearch" Width="180" Height="25" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Категория:" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbType" Width="150" Height="25" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Мастер:" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbMaster" Width="150" Height="25" SelectionChanged="FilterChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" x:Name="LBoxServices" HorizontalContentAlignment="Stretch" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding ServiceTypes.Name}" Foreground="#7F8C8D" Margin="0,2"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб.}" FontSize="16" Foreground="#E67E22" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Выбрать" Width="100" Height="35"
                                    Background="#2C3E50" Foreground="White" 
                                    Tag="{Binding Id}" Click="BtnSelect_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
