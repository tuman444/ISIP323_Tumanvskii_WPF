<Page x:Class="PR17.Pages.Shop.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Background="White">
        <Border Background="#2C3E50" CornerRadius="15" Padding="30" Width="450">
            <StackPanel>
                <TextBlock Text="Детали заказа" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="White"/>

                <TextBlock Text="Выберите день получения:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
                <DatePicker x:Name="DpDeliveryDate" Height="30" Margin="0,0,0,20" FontSize="14"/>

                <TextBlock Text="Способ оплаты:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
                <ComboBox x:Name="CmbPayment" Height="30" Margin="0,0,0,30" FontSize="14">
                    <ComboBoxItem Content="Наличными при получении" IsSelected="True"/>
                    <ComboBoxItem Content="Картой при получении"/>
                    <ComboBoxItem Content="СБП (По QR коду)"/>
                </ComboBox>

                <UniformGrid Columns="2">
                    <Button Content="Подтвердить" Click="BtnConfirm_Click" Height="40" Margin="0,0,5,0" 
                            Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Отмена" Click="BtnCancel_Click" Height="40" Margin="5,0,0,0" 
                            Background="Gray" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
