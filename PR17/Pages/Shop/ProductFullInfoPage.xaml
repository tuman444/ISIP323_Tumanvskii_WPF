<Page x:Class="PR17.Pages.Shop.ProductFullInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR17.Pages.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductFullInfoPage">

    <Grid Background="White">
        <Border Background="#34495E" CornerRadius="10" Margin="40" Padding="25" VerticalAlignment="Center" MaxWidth="600">
            <StackPanel>
                <TextBlock Text="Детали товара" FontSize="26" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Наименование" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="20" Margin="0,5,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="Производитель" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding Manufacturers.Name}" Foreground="White" FontSize="18" Margin="0,5,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Рейтинг" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Rating}" Foreground="White" FontSize="18" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Цена" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <Button Content="Назад к списку" Click="BtnBack_Click" Height="45" Margin="0,35,0,0" 
                        Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
